BETTER_AUTH_SECRET=dev-secret-change-me-at-least-32-characters-long
# Google OAuth (optional in dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Turnstile test secret that always passes
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Email: leave empty to print emails to the console
RESEND_API_KEY=
# Web push (generate with: bun run apps/api/scripts/vapid.ts)
VAPID_PRIVATE_KEY=
# Optional Cloudflare API access: screenshots (Browser Rendering), cache purge, usage alerts
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_ZONE_ID=
