{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "toolmarket-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "binding": "ASSETS", "directory": "./dist" },
  "observability": { "enabled": true },
  // Local dev uses the top-level vars; `bun run deploy` builds with CLOUDFLARE_ENV=production (env.production below).
  "vars": {
    "SITE_NAME": "Tryworthy",
    "SITE_URL": "http://localhost:4321",
    // Public API origin used by the browser (api. subdomain in production).
    "PUBLIC_API_URL": "http://localhost:8787",
    // Public base URL for product images (img. subdomain in production).
    "TURNSTILE_SITE_KEY": "",
    "GOOGLE_ENABLED": "false",
    // Legal pages show "Draft — pending legal review" until a lawyer has reviewed them; then "false".
    "LEGAL_DRAFT": "true",
    // PostHog (docs/ANALYTICS.md): the project token is public. Empty token = no analytics.
    "POSTHOG_KEY": "phc_xd4FUiV4QfTvty5eYeUXxBEGNYURBMkkfHvUMXidvGth",
    "POSTHOG_HOST": "https://us.i.posthog.com"
  },
  // Server-side calls to the API go through a service binding (no public round trip, no extra request).
  "services": [{ "binding": "API", "service": "toolmarket-api" }],
  // Secret: INTERNAL_SECRET (same value as the API worker) protects /internal/purge and marks
  // server-side API calls.
  "env": {
    "production": {
      "name": "toolmarket-web",
      "routes": [{ "pattern": "tryworthy.app", "custom_domain": true }],
      // Vars and bindings are not inherited from the top level, so they are repeated here.
      "vars": {
        "SITE_NAME": "Tryworthy",
        // The canonical origin: canonical tags, sitemap, robots.txt, Open Graph and JSON-LD URLs.
        "SITE_URL": "https://tryworthy.app",
        "PUBLIC_API_URL": "https://api.tryworthy.app",
        // Fill in before launch.
        "TURNSTILE_SITE_KEY": "0x4AAAAAAGNHM79gttN-OhT6",
        "GOOGLE_ENABLED": "true",
        "LEGAL_DRAFT": "true",
        "POSTHOG_KEY": "phc_xd4FUiV4QfTvty5eYeUXxBEGNYURBMkkfHvUMXidvGth",
        "POSTHOG_HOST": "https://us.i.posthog.com"
      },
      "services": [{ "binding": "API", "service": "toolmarket-api" }]
    }
  }
}
