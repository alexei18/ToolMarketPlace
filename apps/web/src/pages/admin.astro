---
import type { AdminDecisionDTO, ReviewCaseDTO, ReviewQueueItemDTO } from "@tm/shared";
import Admin from "../islands/Admin";
import Base from "../layouts/Base.astro";
import { apiCall } from "../lib/api";
import { requireMe } from "../lib/session";

const me = await requireMe(Astro);
if (me instanceof Response) return me;
if (me.role !== "admin") return Astro.rewrite("/404");
const res = await apiCall<{ items: ReviewQueueItemDTO[]; cases: ReviewCaseDTO[]; contests: AdminDecisionDTO[] }>("/admin/review-queue", { request: Astro.request });
---

<Base title="Admin" noindex>
  <div class="container page">
    <div class="spread" style="margin-bottom: 24px">
      <h1 class="t-32">Admin</h1>
      <a class="btn btn-secondary" href="/admin/waitlist">Waitlist</a>
    </div>
    <Admin client:load queue={res.ok ? res.data.items : []} cases={res.ok ? res.data.cases : []} contests={res.ok ? res.data.contests : []} meId={me.id} />
  </div>
</Base>

<style is:global>
  .queue-item {
    padding: 20px 0;
    border-bottom: 1px solid var(--border);
  }
  .report-list {
    margin-top: 12px;
    padding: 12px 14px;
    background: var(--surface);
    border-radius: var(--radius);
    display: grid;
    gap: 8px;
  }
  .decision-form {
    margin-top: 12px;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    max-width: 560px;
  }
</style>
