---
import type { ClaimedPerkDTO } from "@tm/shared";
import EmptyState from "../../components/EmptyState.astro";
import ErrorState from "../../components/ErrorState.astro";
import ProductImage from "../../components/ProductImage.astro";
import Base from "../../layouts/Base.astro";
import { apiCall } from "../../lib/api";
import { PERK_TYPE_LABEL, expiresLabel, longDate } from "../../lib/format";
import { requireMe } from "../../lib/session";

const me = await requireMe(Astro);
if (me instanceof Response) return me;
const res = await apiCall<{ items: ClaimedPerkDTO[] }>("/me/perks", { request: Astro.request });
---

<Base title="Your perks" noindex>
  <div class="container container-narrow page">
    <h1 class="t-32">Your perks</h1>
    <p class="muted" style="margin-top: 8px">Codes and offers you claimed. Codes are only visible to you.</p>
    <section class="section-tight">
      {!res.ok && <ErrorState />}
      {
        res.ok && res.data.items.length === 0 && (
          <EmptyState title="No perks claimed yet" text="Makers offer extended trials, discounts and codes to members. Look for “Member perk” on product pages.">
            <a class="btn btn-dark" href="/search?perk=1">Find products with perks</a>
          </EmptyState>
        )
      }
      {
        res.ok && res.data.items.length > 0 && (
          <ul class="list-plain">
            {res.data.items.map((p) => (
              <li class="perk-card">
                <a class="thumb" href={`/p/${p.product.slug}`} aria-hidden="true" tabindex="-1">
                  <ProductImage image={p.product.image} title={p.product.title} sizes="120px" />
                </a>
                <div class="stack-8">
                  <div>
                    <a class="w-600 t-17" href={`/p/${p.product.slug}`}>{p.product.title}</a>
                    <div class="t-15">{p.title}</div>
                    <div class="t-13 muted">
                      {PERK_TYPE_LABEL[p.type]} · Claimed {longDate(p.claimedAt)}
                      {expiresLabel(p.expiresAt) && <> · {expiresLabel(p.expiresAt)}</>}
                    </div>
                  </div>
                  {p.code && (
                    <div class="code-reveal">
                      <span>{p.code}</span>
                      <button type="button" class="btn btn-secondary btn-sm" data-copy={p.code}>Copy</button>
                    </div>
                  )}
                  {p.redeemUrl && (
                    <a class="btn btn-secondary btn-sm" style="justify-self: start" href={p.redeemUrl} target="_blank" rel="noopener">
                      Redeem on the maker's site ↗
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>
</Base>

<style>
  .perk-card {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid var(--border);
  }
  .perk-card .thumb {
    aspect-ratio: 16 / 10;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .perk-card .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .perk-card .stack-8 {
    display: grid;
  }
</style>

<script>
  document.addEventListener("click", async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-copy]");
    if (!btn) return;
    await navigator.clipboard?.writeText(btn.dataset.copy!).catch(() => {});
    btn.textContent = "Copied";
    setTimeout(() => (btn.textContent = "Copy"), 1500);
  });
</script>
