---
import AuthForm from "../islands/AuthForm";
import AuthLayout from "../layouts/AuthLayout.astro";
---

<AuthLayout title="Reset password" heading="Reset your password" sub="Enter your account email and we'll send you a link to set a new password.">
  <AuthForm client:load mode="forgot" googleEnabled={false} />
  <Fragment slot="foot">Remembered it? <a class="link" href="/login">Log in</a></Fragment>
</AuthLayout>
