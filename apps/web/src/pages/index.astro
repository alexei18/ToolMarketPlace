---
import { homeJsonLd, longDate, type HomeDTO } from "@tm/shared";
import { en } from "@tm/shared/copy";
import ErrorState from "../components/ErrorState.astro";
import Icon from "../components/Icon.astro";
import ProductTile from "../components/ProductTile.astro";
import Waitlist from "../components/Waitlist.astro";
import Base from "../layouts/Base.astro";
import { apiCall } from "../lib/api";
import { siteConfig } from "../lib/config";
import { homeSeo } from "../lib/seo";

const { siteName, siteUrl } = siteConfig();
const [res, site] = await Promise.all([apiCall<HomeDTO>("/home"), apiCall<{ launchDate: string | null }>("/site")]);
// The hero and makers copy depend on the pre-launch flag, which only the API knows: no guessing when it's down.
if (res.ok) Astro.cache.set({ maxAge: 60, swr: 60, tags: ["home", "products"] });
else Astro.response.status = 503;

const home = res.ok ? res.data : null;
// Pre-launch mode runs as the waitlist: the homepage is the waitlist page (components/Waitlist.astro).
const prelaunch = home?.prelaunch ?? false;
const launchDate = site.ok && site.data.launchDate ? longDate(site.data.launchDate) : null;
const top = home?.top ?? null;
const categories = home?.categories ?? [];
const listed = categories.filter((c) => c.listed !== false);
const h1 = Astro.url.searchParams.get("h") === "b" ? en.home.hero.h1B : en.home.hero.h1A;
const makers = en.makers;
const hero = en.home.hero;
const steps = [en.home.howItWorks.pick, en.home.howItWorks.rank, en.home.howItWorks.first];
const pillars = Object.values(en.home.benefits);

const jsonLd = homeJsonLd({ name: siteName, url: siteUrl, logo: `${siteUrl}/brand/icon-512.png` });
---

<Base jsonLd={jsonLd} header={!prelaunch} seo={prelaunch ? { title: homeSeo(siteName).title, description: en.seo.waitlist.description } : undefined}>
  {
    !home && (
      <div class="container page">
        <ErrorState />
      </div>
    )
  }
  {home && prelaunch && <Waitlist categories={categories} waitingCount={home.waitingCount} launchDate={launchDate} siteName={siteName} />}
  {
    home && !prelaunch && (
      <>
        <section class="container hero">
          <h1>{h1}</h1>
          <p class="t-17 muted lede">{hero.subtitle}</p>
          <div class="row row-wrap hero-actions">
            <a class="btn btn-primary btn-lg" href="/signup">{hero.ctaPrimary}</a>
            {top && <a class="btn btn-secondary btn-lg" href="#top">{hero.ctaSecondary}</a>}
          </div>
          <p class="t-13 muted trust">{hero.trustLine}</p>
        </section>

        <section class="container section problem">
          <h2 class="t-32">{en.home.problem.title}</h2>
          <p class="t-17 muted">{en.home.problem.text}</p>
        </section>

        <section class="container section" id="categories">
          <h2 class="visually-hidden">How it works</h2>
          <ol class="list-plain how-steps">
            {
              steps.map((s, i) => (
                <li>
                  <span class="step-n" aria-hidden="true">{i + 1}</span>
                  <h3 class="t-17 w-600">{s.title}</h3>
                  <p class="muted">{typeof s.text === "function" ? s.text(categories.length || null) : s.text}</p>
                </li>
              ))
            }
          </ol>
          {
            listed.length > 0 && (
              <div class="row row-wrap cat-chips">
                {listed.map((c) => (
                  <a class="chip" href={`/c/${c.slug}`}>
                    {c.name}
                  </a>
                ))}
              </div>
            )
          }
        </section>

        <section class="container section">
          <h2 class="visually-hidden">Benefits</h2>
          <ul class="list-plain pillars">
            {
              pillars.map((p) => (
                <li>
                  <h3 class="t-15 w-600">{p.title}</h3>
                  <p class="muted">{p.text}</p>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="container section">
          <div class="creators">
            <h2 class="t-22">{en.home.creators.title}</h2>
            <div class="stack-16">
              <p class="muted">{en.home.creators.text}</p>
              {
                top && (
                  <a class="link-arrow" href="#top">
                    {en.home.creators.cta} <Icon name="arrow-right" />
                  </a>
                )
              }
            </div>
          </div>
        </section>

        {
          top && (
            <section class="container section" id="top">
              <div class="section-head">
                <h2>{en.feed.tabs.top}</h2>
                <a class="t-13 muted" href="/ranking">
                  {en.feed.rankingLink}
                </a>
              </div>
              <p class="t-13 muted top-note">{en.feed.tabsNote}</p>
              <ul class="top-grid">
                {top.map((p, i) => (
                  <ProductTile product={p} sizes={i < 2 ? "(max-width: 960px) 100vw, 590px" : "(max-width: 960px) 50vw, 290px"} />
                ))}
              </ul>
            </section>
          )
        }

        <section class="container section">
          <div class="makers">
            <h2 class="t-22">{makers.title}</h2>
            <a class="btn btn-dark btn-lg" href="/dashboard/new">
              {makers.cta} <Icon name="arrow-right" />
            </a>
          </div>
        </section>
      </>
    )
  }
</Base>

<style>
  .hero {
    padding-top: 88px;
    padding-bottom: 24px;
  }
  .hero h1 {
    max-width: 15ch;
    font-size: clamp(38px, 6.2vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  .lede {
    max-width: 560px;
    margin-top: 24px;
  }
  .hero-actions {
    margin-top: 32px;
    gap: 12px;
  }
  .trust {
    margin-top: 20px;
  }

  .problem {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 32px 64px;
    align-items: start;
  }
  .problem h2 {
    padding-top: 24px;
    border-top: 1px solid var(--text);
  }
  .problem p {
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .how-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .how-steps li {
    padding: 0 32px 0 0;
  }
  .how-steps li + li {
    padding-left: 32px;
    border-left: 1px solid var(--border);
  }
  .step-n {
    display: block;
    margin-bottom: 20px;
    font-size: var(--fs-32);
    font-weight: 600;
    line-height: 1;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .how-steps p {
    margin-top: 6px;
  }
  .cat-chips {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
  }
  .pillars li {
    padding-top: 16px;
    border-top: 2px solid var(--text);
  }
  .pillars p {
    margin-top: 6px;
  }

  .creators {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 24px 64px;
    padding: 40px;
    border-radius: var(--radius-img);
    background: var(--accent-soft);
  }
  .creators h2 {
    max-width: 20ch;
  }
  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    color: var(--accent);
  }
  .link-arrow :global(svg) {
    width: 16px;
    height: 16px;
  }

  .top-note {
    margin-top: 10px;
  }
  .top-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 40px 28px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }
  .top-grid > :global(li) {
    grid-column: span 3;
  }
  .top-grid > :global(li:nth-child(-n + 2)) {
    grid-column: span 6;
  }
  .top-grid > :global(li:nth-child(-n + 2) .title) {
    font-size: var(--fs-22);
  }

  .makers {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px 48px;
    padding: 32px 0;
    border-top: 1px solid var(--text);
    border-bottom: 1px solid var(--border);
  }
  .makers h2 {
    max-width: 30ch;
  }
  .makers :global(.btn) {
    flex: none;
  }

  @media (max-width: 960px) {
    .problem,
    .creators {
      grid-template-columns: minmax(0, 1fr);
    }
    .problem p {
      padding-top: 0;
      border-top: 0;
    }
    .pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .top-grid > :global(li),
    .top-grid > :global(li:nth-child(-n + 2)) {
      grid-column: span 6;
    }
  }
  @media (max-width: 720px) {
    .hero {
      padding-top: 48px;
    }
    .how-steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    .how-steps li,
    .how-steps li + li {
      padding: 0;
      border-left: 0;
    }
    .how-steps li + li {
      padding-top: 28px;
      border-top: 1px solid var(--border);
    }
    .step-n {
      margin-bottom: 12px;
      font-size: var(--fs-22);
    }
    .creators {
      padding: 28px 20px;
    }
    .makers {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  @media (max-width: 560px) {
    .pillars {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .top-grid > :global(li:nth-child(-n + 2)) {
      grid-column: span 12;
    }
    .top-grid {
      gap: 28px 16px;
    }
    .hero-actions .btn {
      flex: 1 1 100%;
    }
    .makers :global(.btn) {
      width: 100%;
    }
  }
</style>
