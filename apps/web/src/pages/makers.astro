---
import { en } from "@tm/shared/copy";
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
import { apiCall } from "../lib/api";
import { siteConfig } from "../lib/config";

const { siteName } = siteConfig();
const res = await apiCall<{ prelaunch: boolean }>("/site");
// Tagged "site" so the Launch action can refresh it with the homepage.
if (res.ok) Astro.cache.set({ maxAge: 300, swr: 300, tags: ["site"] });
const makers = res.ok && res.data.prelaunch ? en.prelaunch.makers : en.makers;
const page = en.makersPage;
---

<Base title={en.footer.links.makers} description={page.why.text}>
  <div class="container page">
    <header class="makers-head">
      <h1 class="t-48">{makers.title}</h1>
      <a class="btn btn-primary btn-lg" href="/dashboard/new">
        {makers.cta} <Icon name="arrow-right" />
      </a>
    </header>

    <section class="part">
      <h2 class="t-22">{page.why.title}</h2>
      <div class="stack-12">
        <p class="t-17">{page.why.text}</p>
        <p class="t-17 muted">{page.why.free}</p>
      </div>
    </section>

    <section class="part">
      <h2 class="t-22">{en.ranking.title}</h2>
      <p class="t-17">{en.ranking.body}</p>
    </section>

    <section class="part">
      <h2 class="t-22">{page.perks.title}</h2>
      <div class="stack-12">
        <p class="t-17">{page.perks.text}</p>
        <span class="perk-badge"><Icon name="gift" />{en.product.perkBadge(siteName)}</span>
      </div>
    </section>

    <section class="part">
      <h2 class="t-22">{page.preLaunch.title}</h2>
      <div class="stack-12">
        <p class="t-17">{page.preLaunch.text}</p>
        <span class="badge" data-badge="preLaunch">{en.feed.badges.preLaunch}</span>
      </div>
    </section>

    <div class="part part-cta">
      <a class="btn btn-dark btn-lg" href="/dashboard/new">
        {makers.cta} <Icon name="arrow-right" />
      </a>
    </div>
  </div>
</Base>

<style>
  .makers-head {
    display: grid;
    gap: 28px;
    justify-items: start;
    max-width: 820px;
    padding: 32px 0 56px;
  }
  .part {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 16px 48px;
    padding: 32px 0;
    border-top: 1px solid var(--border);
  }
  .part:first-of-type {
    border-top-color: var(--text);
  }
  .part p {
    max-width: 640px;
  }
  .part-cta {
    display: block;
  }
  @media (max-width: 720px) {
    .makers-head {
      padding: 8px 0 40px;
    }
    .part {
      grid-template-columns: minmax(0, 1fr);
      padding: 28px 0;
    }
    .part-cta .btn {
      width: 100%;
    }
  }
</style>
