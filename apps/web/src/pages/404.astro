---
import Base from "../layouts/Base.astro";
Astro.response.status = 404;
---

<Base title="Page not found" noindex>
  <div class="container container-narrow page">
    <div class="stack-16" style="padding-top: 48px">
      <p class="eyebrow">404</p>
      <h1 class="t-48">This page isn't here.</h1>
      <p class="t-17 muted">The link may be old, or the product was removed. Try searching instead.</p>
      <form action="/search" method="get" class="row" style="max-width: 480px; margin-top: 24px">
        <input class="input" type="search" name="q" placeholder="Search products" aria-label="Search products" />
        <button class="btn btn-dark" type="submit">Search</button>
      </form>
      <p style="margin-top: 24px"><a class="link" href="/">Back to the home page</a></p>
    </div>
  </div>
</Base>
