---
import AuthForm from "../islands/AuthForm";
import AuthLayout from "../layouts/AuthLayout.astro";

const token = Astro.url.searchParams.get("token") ?? "";
const invalid = !token || Astro.url.searchParams.get("error") === "INVALID_TOKEN";
---

<AuthLayout title="Set a new password" heading="Set a new password">
  {
    invalid ? (
      <div class="stack-16">
        <div class="notice notice-danger">This link is invalid or expired.</div>
        <a class="btn btn-dark btn-block" href="/forgot-password">Send a new link</a>
      </div>
    ) : (
      <AuthForm client:load mode="reset" token={token} googleEnabled={false} />
    )
  }
</AuthLayout>
