---
import { collectionPageJsonLd, type CategoryDTO, type Page, type ProductCardDTO } from "@tm/shared";
import { en } from "@tm/shared/copy";
import EmptyState from "../../components/EmptyState.astro";
import ErrorState from "../../components/ErrorState.astro";
import FilterBar from "../../components/FilterBar.astro";
import ProductList from "../../components/ProductList.astro";
import RankTabs from "../../components/RankTabs.astro";
import SignupGate from "../../components/SignupGate.astro";
import Base from "../../layouts/Base.astro";
import { apiCall } from "../../lib/api";
import { plural } from "../../lib/format";
import { listParams, listQuery } from "../../lib/listing";
import { siteConfig } from "../../lib/config";
import { categorySeo } from "../../lib/seo";

const slug = Astro.params.slug!;
const { sort, filters, indexable } = listParams(Astro.url);
const view = listQuery(sort, filters);
const [catRes, listRes, allRes] = await Promise.all([
  apiCall<CategoryDTO>(`/categories/${encodeURIComponent(slug)}`),
  // Rendered as a visitor so the cached page is the same for everyone; members load the rest client-side.
  apiCall<Page<ProductCardDTO>>(`/categories/${encodeURIComponent(slug)}/products${view}`),
  apiCall<{ items: CategoryDTO[] }>("/categories"),
]);

if (!catRes.ok && catRes.status === 404) {
  return Astro.rewrite("/404");
}
const failed = !catRes.ok || !listRes.ok;
if (failed) Astro.response.status = 503;
else Astro.cache.set({ maxAge: 60, swr: 60, tags: ["products", `c:${slug}`] });

const category = catRes.ok ? catRes.data : null;
const page = listRes.ok ? listRes.data : { items: [], nextCursor: null, limited: false };
const all = allRes.ok ? allRes.data.items : [];
const count = all.find((c) => c.slug === slug)?.productCount ?? page.items.length;
const memberCursor = page.limited ? (page.resumeCursor ?? null) : null;
const { siteName, siteUrl } = siteConfig();
// Filtered views and, in pre-launch, categories with too few quality products stay out of the index (docs/SEO.md).
const listed = all.find((c) => c.slug === slug)?.listed !== false;
const seo = category ? categorySeo(category.name, siteName) : undefined;
const pageUrl = `${siteUrl}/c/${slug}`;
// Structured data describes the indexed view: Top this week without filters, as shown to visitors.
const jsonLd =
  category && seo && indexable
    ? collectionPageJsonLd({
        name: en.category.h1(category.name),
        description: seo.description,
        url: pageUrl,
        items: page.items.map((p) => ({ name: p.title, url: `${siteUrl}/p/${p.slug}` })),
        crumbs: [
          { name: "Home", url: `${siteUrl}/` },
          { name: category.name, url: pageUrl },
        ],
      })
    : null;
const fragment = `/fragments/products?${new URLSearchParams({ source: "category", slug, ...(sort !== "top" ? { sort } : {}), ...Object.fromEntries(filters) })}`;
const viewLabel = en.feed.tabs[sort];
---

<Base title={category ? undefined : "Category"} seo={seo} noindex={!indexable || !listed} jsonLd={jsonLd}>
  <div class="container page">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/#categories">Categories</a></nav>
    {failed && <div style="margin-top: 24px"><ErrorState /></div>}
    {
      category && (
        <>
          <header class="cat-head">
            <h1 class="t-48">{en.category.h1(category.name)}</h1>
            <p class="t-17 muted">{en.category.intro(category.name)}</p>
            <p class="t-13 muted">{plural(count, "product")}</p>
          </header>

          <div class="cat-strip" role="navigation" aria-label="Other categories">
            {all.map((c) => (
              <a class="chip" href={`/c/${c.slug}`} aria-current={c.slug === slug ? "page" : undefined}>
                {c.name}
              </a>
            ))}
          </div>

          <section class="section-tight">
            <FilterBar base={`/c/${slug}`} sort={sort} filters={filters} />
            <RankTabs base={`/c/${slug}`} sort={sort} filters={filters} />
            <h2 class="visually-hidden">{viewLabel}</h2>
            {page.items.length === 0 && sort === "new" && (
              <div style="margin-top: 20px">
                <EmptyState title={`No ${category.name} products yet`} text="New launches show up here the moment makers publish them.">
                  <a class="btn btn-secondary" href="/dashboard/new">Submit a product</a>
                </EmptyState>
              </div>
            )}
            {page.items.length === 0 && sort !== "new" && (
              <div style="margin-top: 20px">
                <EmptyState title="Nothing ranked here yet" text="New launches need a few days of saves, perk claims and feedback to show up here.">
                  <a class="btn btn-secondary" href={`/c/${slug}${listQuery("new", filters)}`}>{en.feed.tabs.new}</a>
                </EmptyState>
              </div>
            )}
            {page.items.length > 0 && <ProductList id="cat-list" products={page.items} />}

            {memberCursor && (
              <>
                <div class="load-more member-only-block">
                  <button type="button" class="btn btn-secondary" data-load-more data-target="cat-list" data-source={fragment} data-cursor={memberCursor} data-requires-auth="true">
                    Load more
                  </button>
                </div>
                <div class="visitor-only-block">
                  <SignupGate text={en.category.visitorBanner(category.name)} />
                </div>
              </>
            )}
          </section>
        </>
      )
    }
  </div>
</Base>

<style>
  .cat-head {
    margin-top: 16px;
    display: grid;
    gap: 10px;
    max-width: 720px;
  }
  .cat-strip {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 28px 0 4px;
    scrollbar-width: none;
    mask-image: linear-gradient(90deg, #000 92%, transparent);
  }
  .cat-strip a[aria-current="page"] {
    background: var(--text);
    color: #fff;
    border-color: var(--text);
  }
  .member-only-block {
    display: none;
  }
  :global(html[data-auth="1"]) .member-only-block {
    display: flex;
  }
  :global(html[data-auth="1"]) .visitor-only-block {
    display: none;
  }
</style>
