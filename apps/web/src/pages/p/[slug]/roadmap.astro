---
import type { ProductDetailDTO, RoadmapItemDTO, RoadmapStatus } from "@tm/shared";
import EmptyState from "../../../components/EmptyState.astro";
import Icon from "../../../components/Icon.astro";
import ProductLayout from "../../../layouts/ProductLayout.astro";
import { apiCall } from "../../../lib/api";
import { ROADMAP_LABEL } from "../../../lib/format";

const slug = Astro.params.slug!;
const pRes = await apiCall<ProductDetailDTO>(`/products/${encodeURIComponent(slug)}`);
if (!pRes.ok && pRes.status === 410) {
  Astro.locals.goneCategory = pRes.error.category;
  return Astro.rewrite("/gone");
}
if (!pRes.ok) return Astro.rewrite(pRes.status === 404 ? "/404" : "/unavailable");
const p = pRes.data;
if (!p.roadmapEnabled) return Astro.redirect(`/p/${p.slug}`, 302);

Astro.response.headers.set("Cache-Control", "private, no-cache");
const rRes = await apiCall<{ items: RoadmapItemDTO[] }>(`/products/${p.id}/roadmap`, { request: Astro.request });
const items = rRes.ok ? rRes.data.items : [];
const columns: RoadmapStatus[] = ["in_progress", "planned", "shipped"];
---

<ProductLayout product={p} active="roadmap" title={`${p.title} roadmap`} description={`What's planned, in progress and shipped for ${p.title}. Vote for what should come next.`}>
  {
    items.length === 0 ? (
      <EmptyState title="The roadmap is empty for now" text={`${p.maker.name} hasn't added items yet. Leave an idea in the feedback tab.`} />
    ) : (
      <div class="roadmap-cols">
        {columns.map((status) => {
          const list = items.filter((i) => i.status === status).sort((a, b) => b.voteCount - a.voteCount);
          return (
            <section aria-labelledby={`col-${status}`}>
              <div class="section-head">
                <h2 id={`col-${status}`}>
                  <span class="status" data-status={status}>
                    {ROADMAP_LABEL[status]}
                  </span>
                </h2>
                <span class="t-13 muted">{list.length}</span>
              </div>
              {list.length === 0 ? (
                <p class="t-13 muted" style="padding: 14px 0">Nothing here yet.</p>
              ) : (
                <ul class="list-plain">
                  {list.map((item) => (
                    <li class="roadmap-item">
                      <button type="button" class="vote-btn" data-vote={item.id} aria-pressed={item.voted ? "true" : "false"} aria-label={`Vote for ${item.title}`} disabled={status === "shipped"}>
                        <Icon name="arrow-up" />
                        <span data-count>{item.voteCount}</span>
                      </button>
                      <div>
                        <div class="w-600">{item.title}</div>
                        {item.description && <p class="t-15 muted" style="margin-top: 2px">{item.description}</p>}
                        {item.fromFeedbackId && <p class="t-13 faint" style="margin-top: 4px">Suggested by a user</p>}
                      </div>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          );
        })}
      </div>
    )
  }
</ProductLayout>
