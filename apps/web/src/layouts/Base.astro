---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { serializeJsonLd, webPageJsonLd, type JsonLdGraph } from "@tm/shared";
import Seo from "../components/Seo.astro";
import { siteConfig } from "../lib/config";
import { homeSeo, withSite, type SeoText } from "../lib/seo";

interface Props {
  /** Page name; the title becomes "<title> · <site>". */
  title?: string;
  /** A full title and description from a docs/SEO.md template (lib/seo.ts); wins over `title`. */
  seo?: SeoText;
  description?: string;
  /** Root-relative or absolute canonical; defaults to the requested path (also after a rewrite). Query params are always dropped. */
  canonical?: string;
  image?: string | null;
  /** Pixel size of `image` (the default OG image is 1200×630). */
  imageSize?: { width: number; height: number };
  noindex?: boolean;
  query?: string;
  /** Built with the JSON-LD helpers in @tm/shared (docs/SEO.md). */
  jsonLd?: JsonLdGraph | null;
  /** Hide header/footer (auth pages). */
  bare?: boolean;
}

const { siteName, siteUrl, apiUrl, turnstileSiteKey } = siteConfig();
const { title, seo, description, canonical = Astro.originPathname, image = null, imageSize, noindex = false, query, jsonLd = null, bare = false } = Astro.props;

const home = homeSeo(siteName);
const fullTitle = seo?.title ?? (title ? withSite(title, siteName) : home.title);
const metaDescription = seo?.description ?? description ?? home.description;
// No query or fragment, and no trailing slash except on the home page (originPathname may add one).
const canonicalPath = canonical.split(/[?#]/)[0]!.replace(/(.)\/$/, "$1");
const canonicalUrl = canonicalPath.startsWith("http") ? canonicalPath : `${siteUrl}${canonicalPath}`;
const ogImage = image ?? `${siteUrl}/og.png`;
const ogSize = image ? imageSize : { width: 1200, height: 630 };
// Indexable pages without their own graph still describe themselves (docs/SEO.md: JSON-LD on every public page).
const graph = jsonLd ?? (noindex ? null : webPageJsonLd({ name: title ?? fullTitle, description: metaDescription, url: canonicalUrl, home: `${siteUrl}/` }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={fullTitle} description={metaDescription} canonical={canonicalUrl} image={ogImage} imageWidth={ogSize?.width} imageHeight={ogSize?.height} noindex={noindex} siteName={siteName} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="api-origin" content={apiUrl} />
    {turnstileSiteKey && <meta name="turnstile-site-key" content={turnstileSiteKey} />}
    <script is:inline>
      // Runs before paint: mark signed-in visitors (hint cookie only, no secrets) so cached pages
      // can show the right header without a flash, and send them from the landing page to their feed.
      if (/(?:^|;\s*)tm_auth=1/.test(document.cookie)) {
        document.documentElement.dataset.auth = "1";
        if (location.pathname === "/" && !location.search.includes("home=1")) location.replace("/feed");
      }
      // Remembers what is typed into a field before its form's script has loaded (slow connections);
      // the form adopts it when it starts (useAdoptTyped). Fields React already manages are skipped.
      window.__typed = {};
      addEventListener(
        "input",
        function (e) {
          var t = e.target;
          if (!t || !t.id) return;
          var managed = Object.keys(t).some(function (k) {
            return k.indexOf("__reactFiber") === 0;
          });
          if (!managed) window.__typed[t.id] = t.value;
        },
        true,
      );
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href={apiUrl} crossorigin="use-credentials" />
    {graph && <script type="application/ld+json" set:html={serializeJsonLd(graph)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>
    {!bare && <Header query={query} />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}
    <div id="toasts" class="toasts" role="status" aria-live="polite"></div>
    <script>
      import "../scripts/global";
    </script>
  </body>
</html>
