---
interface Props {
  title?: string;
  text?: string;
}
const { title = "We couldn't load this page", text = "Something went wrong on our side. Refresh in a moment." } = Astro.props;
---

<div class="empty">
  <h3>{title}</h3>
  <p>{text}</p>
  <div class="actions"><a class="btn btn-secondary" href={Astro.url.pathname}>Try again</a></div>
</div>
