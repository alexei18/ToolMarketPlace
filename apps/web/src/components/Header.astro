---
import { en } from "@tm/shared/copy";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { siteConfig } from "../lib/config";

interface Props {
  query?: string;
}
const { query = "" } = Astro.props;
const { siteName } = siteConfig();
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="wordmark" aria-label={`${siteName} home`}><Logo /><span>{siteName}</span></a>
    <nav class="site-nav" aria-label="Main">
      <a href="/top" aria-current={path === "/top" ? "page" : undefined}>{en.feed.tabs.top}</a>
      <a href="/trending" aria-current={path === "/trending" ? "page" : undefined}>{en.feed.tabs.trending}</a>
      <a href="/new" aria-current={path === "/new" ? "page" : undefined}>{en.feed.tabs.new}</a>
      <a href="/#categories">Categories</a>
      <a href="/dashboard/new" aria-current={path.startsWith("/dashboard") ? "page" : undefined}>Submit a product</a>
    </nav>
    <form class="header-search" action="/search" method="get" role="search">
      <Icon name="search" />
      <input type="search" name="q" value={query} placeholder="Search new products" aria-label="Search products" autocomplete="off" />
    </form>
    <div class="header-actions" id="header-actions">
      <a class="icon-link show-sm" href="/search" aria-label="Search"><Icon name="search" size={18} /></a>
      <details class="menu nav-menu">
        <summary class="icon-link" aria-label="Menu"><Icon name="menu" size={18} /></summary>
        <div class="menu-panel">
          <a href="/top"><Icon name="arrow-up" />{en.feed.tabs.top}</a>
          <a href="/trending"><Icon name="trending" />{en.feed.tabs.trending}</a>
          <a href="/new"><Icon name="clock" />{en.feed.tabs.new}</a>
          <a href="/#categories"><Icon name="grid" />Categories</a>
          <a href="/dashboard/new"><Icon name="plus" />Submit a product</a>
          <a class="menu-login" href="/login"><Icon name="user" />Log in</a>
        </div>
      </details>
      <div class="row visitor-only">
        <a class="btn btn-ghost btn-sm" href="/login">Log in</a>
        <a class="btn btn-dark btn-sm" href="/signup">Sign up</a>
      </div>
      <div class="row member-only" id="member-actions">
        <a class="icon-link" href="/notifications" aria-label="Notifications" id="bell"><Icon name="bell" size={18} /></a>
        <span class="avatar skeleton" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</header>
<div id="account-notice"></div>

<style>
  .member-only {
    display: none;
  }
  :global(html[data-auth="1"]) .member-only {
    display: flex;
  }
  :global(html[data-auth="1"]) .visitor-only {
    display: none;
  }
  .show-sm {
    display: none;
  }
  @media (max-width: 640px) {
    .show-sm {
      display: inline-grid;
    }
    /* Phones: "Log in" moves into the menu so search, menu and "Sign up" fit next to the logo. */
    .visitor-only .btn-ghost {
      display: none;
    }
    :global(html:not([data-auth="1"])) .menu-login {
      display: flex;
    }
  }
  .nav-menu,
  .menu-login {
    display: none;
  }
  @media (max-width: 1080px) {
    .nav-menu {
      display: block;
    }
  }
  #account-notice:empty {
    display: none;
  }
</style>

<script>
  import { TERMS_VERSION } from "@tm/shared";
  import { en } from "@tm/shared/copy";
  import { getMe, hasSession, post, toast, errorMessage } from "../lib/client";
  import { iconSvg } from "./icons";

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);

  function initialsOf(name: string) {
    const p = name.trim().split(/\s+/);
    return ((p.length > 1 ? p[0]![0]! + p[p.length - 1]![0]! : name.slice(0, 2)) || "?").toUpperCase();
  }

  async function init() {
    if (!hasSession()) return;
    const me = await getMe();
    const root = document.getElementById("member-actions");
    if (!root) return;
    if (!me) {
      document.documentElement.removeAttribute("data-auth");
      return;
    }
    const avatar = me.image ? `<img src="${esc(me.image)}" alt="" referrerpolicy="no-referrer" width="32" height="32">` : esc(initialsOf(me.name));
    const item = (href: string, icon: Parameters<typeof iconSvg>[0], label: string) => `<a href="${href}">${iconSvg(icon)}${label}</a>`;
    root.innerHTML = `
      <a class="icon-link" href="/notifications" aria-label="Notifications${me.unreadNotifications ? ` (${me.unreadNotifications} unread)` : ""}">
        ${iconSvg("bell", { size: 18 })}${me.unreadNotifications ? '<span class="dot"></span>' : ""}
      </a>
      <details class="menu">
        <summary aria-label="Account menu"><span class="avatar">${avatar}</span></summary>
        <div class="menu-panel">
          <div class="menu-head"><div class="w-600 truncate">${esc(me.name)}</div><div class="t-13 muted truncate">${me.username ? "@" + esc(me.username) : esc(me.email)}</div></div>
          ${item("/feed", "sparkles", "Your feed")}
          ${item("/saved", "bookmark", "Saved")}
          ${item("/perks/claimed", "gift", "Your perks")}
          <hr>
          ${me.isMaker ? item("/dashboard", "dashboard", "Maker dashboard") : item("/dashboard/domains", "globe", "Become a maker")}
          ${me.username ? item("/m/" + encodeURIComponent(me.username), "user", "Public profile") : ""}
          ${me.role === "admin" ? item("/admin", "shield", "Admin") : ""}
          ${item("/settings", "settings", "Settings")}
          <hr>
          <button type="button" data-signout>${iconSvg("logout")}Log out</button>
        </div>
      </details>`;
    root.querySelector("[data-signout]")?.addEventListener("click", async () => {
      try {
        await post("/auth/sign-out", {});
        location.href = "/";
      } catch (err) {
        toast(errorMessage(err), "error");
      }
    });

    const notice = document.getElementById("account-notice");
    if (notice && (me as { banned?: boolean }).banned) {
      notice.innerHTML = `<div class="container" style="padding-top:12px;padding-bottom:12px"><div class="notice notice-danger">${iconSvg("alert")}<span>This account has been suspended. <a class="link" href="/suspended">See why and contest the decision</a>.</span></div></div>`;
    } else if (notice && !me.emailVerified) {
      notice.innerHTML = `<div class="container" style="padding-top:12px;padding-bottom:12px"><div class="notice notice-warning">${iconSvg("info")}<span>Confirm your email (<b>${esc(me.email)}</b>) to claim perks and publish products. <button type="button" class="btn-text t-15" data-resend>Resend the email</button></span></div></div>`;
      notice.querySelector("[data-resend]")?.addEventListener("click", async () => {
        try {
          await post("/auth/send-verification-email", { email: me.email, callbackURL: `${location.origin}/feed?verified=1` });
          toast("Sent. Check your inbox.");
        } catch (err) {
          toast(errorMessage(err), "error");
        }
      });
    }

    // One-time notice when the Terms changed since this account last accepted them (docs/LEGAL.md).
    // New accounts accept in sign-up or onboarding, so only onboarded ones get it.
    if (notice && me.onboarded && me.termsVersion !== TERMS_VERSION && !(me as { banned?: boolean }).banned) {
      const box = document.createElement("div");
      box.className = "container";
      box.style.cssText = "padding-top:12px;padding-bottom:12px";
      box.innerHTML = `<div class="notice" style="align-items:center">${iconSvg("info")}<span>${en.legal.termsUpdated} <a class="link" href="/terms#changes-to-these-terms">${en.legal.termsChanges}</a></span><button type="button" class="btn-text t-15" style="margin-left:auto" data-terms-ok>${en.legal.termsDismiss}</button></div>`;
      notice.append(box);
      box.querySelector("[data-terms-ok]")?.addEventListener("click", async () => {
        try {
          await post("/me/terms", { version: TERMS_VERSION });
          box.remove();
        } catch (err) {
          toast(errorMessage(err), "error");
        }
      });
    }
  }

  // Header menus close on a tap outside them (which includes opening the other menu).
  document.addEventListener("click", (e) => {
    document.querySelectorAll(".site-header details.menu[open]").forEach((menu) => {
      if (!menu.contains(e.target as Node)) menu.removeAttribute("open");
    });
  });

  init();
</script>
