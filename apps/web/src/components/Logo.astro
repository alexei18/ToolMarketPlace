---
/**
 * The Tryworthy wordmark: the final file from brand/tryworthy-logo, used as it is.
 * Keep `height` at 20px or more (below that use /brand/tryworthy-mark.svg) and leave clear space of
 * at least the height of the "o" (about 0.54 × height) on every side.
 */
interface Props {
  height?: number;
}
const { height = 24 } = Astro.props;
// Aspect ratio from the SVG viewBox (9206.9 × 2112.9).
const width = Math.round((height * 9206.9) / 2112.9);
---

<img class="logo" src="/brand/tryworthy-wordmark.svg" alt="Tryworthy" width={width} height={height} />
