---
/* The body of /top, /trending and /new: every category, one view per page (docs/SEO.md). */
import { NEW_PAGE_DAYS, collectionPageJsonLd } from "@tm/shared";
import { en } from "@tm/shared/copy";
import Base from "../layouts/Base.astro";
import { siteConfig } from "../lib/config";
import { filterQuery } from "../lib/listing";
import { newSeo, topSeo } from "../lib/seo";
import type { SiteListView } from "../lib/site-lists";
import EmptyState from "./EmptyState.astro";
import ErrorState from "./ErrorState.astro";
import FilterBar from "./FilterBar.astro";
import ProductList from "./ProductList.astro";
import RankTabs from "./RankTabs.astro";
import SignupGate from "./SignupGate.astro";

type Props = SiteListView;
const { sort, filters, page } = Astro.props;

const { siteName, siteUrl } = siteConfig();
const path = `/${sort}`;
const h1 = en.feed.tabs[sort];
const seo = sort === "new" ? newSeo(siteName) : topSeo(siteName);
const hrefs = { top: `/top${filterQuery(filters)}`, trending: `/trending${filterQuery(filters)}`, new: "/new" };
// Filtered views stay out of the index (docs/SEO.md).
const indexable = filters.toString() === "";
const pageUrl = `${siteUrl}${path}`;
const jsonLd =
  page && indexable
    ? collectionPageJsonLd({
        name: h1,
        description: seo.description,
        url: pageUrl,
        items: page.items.map((p) => ({ name: p.title, url: `${siteUrl}/p/${p.slug}` })),
        crumbs: [
          { name: "Home", url: `${siteUrl}/` },
          { name: h1, url: pageUrl },
        ],
      })
    : null;
const memberCursor = page?.limited ? (page.resumeCursor ?? null) : null;
const fragment = `/fragments/products?${new URLSearchParams({ source: "latest", ...(sort !== "top" ? { sort } : {}), ...Object.fromEntries(filters) })}`;
---

<Base seo={seo} noindex={!indexable} jsonLd={jsonLd}>
  <div class="container page">
    <h1 class="t-48 list-title">{h1}</h1>
    <section class="section-tight">
      {sort !== "new" && <FilterBar base={path} filters={filters} />}
      <RankTabs hrefs={hrefs} sort={sort} filters={filters} />
      {!page && <div style="margin-top: 20px"><ErrorState /></div>}
      {
        page && page.items.length === 0 && sort === "new" && (
          <div style="margin-top: 20px">
            <EmptyState title={`Nothing launched in the last ${NEW_PAGE_DAYS} days`} text="New launches show up here the moment makers publish them.">
              <a class="btn btn-secondary" href="/dashboard/new">Submit a product</a>
            </EmptyState>
          </div>
        )
      }
      {
        page && page.items.length === 0 && sort !== "new" && (
          <div style="margin-top: 20px">
            <EmptyState title="Nothing ranked here yet" text="New launches need a few days of saves, perk claims and feedback to show up here.">
              <a class="btn btn-secondary" href="/new">{en.feed.tabs.new}</a>
            </EmptyState>
          </div>
        )
      }
      {page && page.items.length > 0 && <ProductList id="site-list" products={page.items} />}

      {
        memberCursor && (
          <>
            <div class="load-more member-only-block">
              <button type="button" class="btn btn-secondary" data-load-more data-target="site-list" data-source={fragment} data-cursor={memberCursor} data-requires-auth="true">
                Load more
              </button>
            </div>
            <div class="visitor-only-block">
              <SignupGate text={en.feed.visitorBanner} />
            </div>
          </>
        )
      }
    </section>
  </div>
</Base>

<style>
  .list-title {
    margin-top: 16px;
  }
  .member-only-block {
    display: none;
  }
  :global(html[data-auth="1"]) .member-only-block {
    display: flex;
  }
  :global(html[data-auth="1"]) .visitor-only-block {
    display: none;
  }
</style>
