---
import type { ProductCardDTO } from "@tm/shared";
import { PRICING_LABEL, timeAgo } from "../lib/format";
import Icon from "./Icon.astro";
import ProductImage from "./ProductImage.astro";

interface Props {
  product: ProductCardDTO;
}
const { product: p } = Astro.props;
---

<li class="tile">
  <div class="img"><ProductImage image={p.image} title={p.title} sizes="(max-width: 560px) 100vw, 380px" /></div>
  <h3 class="title"><a href={`/p/${p.slug}`}>{p.title}</a></h3>
  <p class="tagline">{p.tagline}</p>
  <div class="meta">
    {p.categories[0] && <span>{p.categories[0].name}</span>}
    <span>{PRICING_LABEL[p.pricing]}</span>
    <span>{timeAgo(p.publishedAt)}</span>
    {
      p.hasPerk && (
        <span class="perk-badge">
          <Icon name="gift" />
          Perk
        </span>
      )
    }
  </div>
</li>
