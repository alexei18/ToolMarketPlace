---
interface Props {
  title?: string;
  text: string;
}
const { title, text } = Astro.props;
// Back to this exact view (tab and filters included) after signing up.
const next = Astro.url.pathname + Astro.url.search;
---

<div class="gate" data-gate>
  <div>
    {title && <h3>{title}</h3>}
    <p>{text}</p>
  </div>
  <div class="row">
    <a class="btn btn-ghost" href={`/login?next=${encodeURIComponent(next)}`}>Log in</a>
    <a class="btn btn-primary" href={`/signup?next=${encodeURIComponent(next)}`}>Create a free account</a>
  </div>
</div>
