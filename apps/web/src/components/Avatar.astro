---
import { initials } from "../lib/format";

interface Props {
  name: string;
  image?: string | null;
  size?: "sm" | "md" | "lg";
}
const { name, image, size = "md" } = Astro.props;
/** Matches the .avatar sizes in global.css. */
const px = { sm: 24, md: 32, lg: 72 }[size];
---

<span class:list={["avatar", size === "lg" && "avatar-lg", size === "sm" && "avatar-sm"]} aria-hidden="true">
  {image ? <img src={image} alt="" referrerpolicy="no-referrer" loading="lazy" width={px} height={px} /> : initials(name)}
</span>
