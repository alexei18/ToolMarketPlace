    "caption": "What if new apps gave you a free month just for trying them first? Perks only on Tryworthy. Join the waitlist, link in bio.",
    "hashtags": [
      "#newapps",
      "#freeperks",
      "#techtok"
    ],
    "pinnedComment": "Which app would you trade a free month for? Join the waitlist, link in bio.",
    "musicSearch": "playful bright pop",
    "changedVariable": ""
  },
  "script": "What if new apps gave you a free month just for trying them first? On Tryworthy, makers offer perks you can't get anywhere else. An extended trial, a discount, or a code that only works here. You find them right on the product page, marked Only on Tryworthy. Sign in, claim the perk, and try the app before everyone else. The maker gets a real user, and you get the deal. Join the waitlist, link in bio.",
  "beats": [
    {
      "cue": "what",
      "scene": "KineticText",
      "props": {
        "lines": [
          "What if new apps",
          "gave you a free",
          "month just for",
          "trying them first?"
        ],
        "mode": "slam",
        "highlight": [
          "free",
          "month"
        ],
        "size": 100
      }
    },
    {
      "cue": "on",
      "scene": "KineticText",
      "props": {
        "lines": [
          "On Tryworthy,",
          "makers",
          "offer perks"
        ],
        "mode": "slam",
        "highlight": [
          "perks"
        ],
        "size": 120
      }
    },
    {
      "cue": "you#2",
      "scene": "CardReveal",
      "props": {
        "front": {
          "title": "Formorchard",
          "text": "Forms that fill a simple database for you"
        },
        "back": {
          "badge": "Only on Tryworthy",
          "title": "Pro plan, first month free",
          "text": "Perks makers give only here."
        },
        "flipCue": "anywhere"
      }
    },
    {
      "cue": "an",
      "scene": "KineticText",
      "props": {
        "lines": [
          "An extended",
          "trial, a discount,",
          "or a code that",
          "only works here."
        ],
        "mode": "slam",
        "highlight": [
          "only"
        ],
        "size": 110
      }
    },
    {
      "cue": "you#3",
      "scene": "PhoneFrame",
      "props": {
        "capture": "v5-product",
        "scroll": [
          {
            "y": 0
          },
          {
            "cue": "right",
            "y": 130
          },
          {
            "cue": "product",
            "y": 500
          }
        ]
      }
    },
    {
      "cue": "marked",
      "scene": "CardCrop",
      "props": {
        "capture": "v5-perk",
        "target": "badge",
        "sweep": [
          {
            "cue": "only#2"
          },
          {
            "cue": "tryworthy#2"
          }
        ]
      }
    },
    {
      "cue": "sign",
      "scene": "CardCrop",
      "props": {
        "capture": "v5-perk",
        "target": "claim",
        "cursor": [
          {
            "cue": "sign",
            "target": "claim",
            "tap": false
          },
          {
            "cue": "claim",
            "target": "claim",
            "tap": true
          }
        ],
        "sweep": [
          {
            "cue": "perk"
          }
        ]
      }
    },
    {
      "cue": "try",
      "scene": "KineticText",
      "props": {
        "lines": [
          "Try the",
          "app before",
          "everyone",
          "else."
        ],
        "mode": "slam",
        "highlight": [
          "before"
        ],
        "size": 130
      }
    },
    {
      "cue": "the#4",
      "scene": "KineticText",
      "props": {
        "lines": [
          "The maker gets",
          "a real user, you",
          "get the deal."
        ],
        "mode": "slam",
        "highlight": [
          "deal"
        ],
        "size": 110
      }
    }
  ],
  "style": {
    "theme": "light",
    "keywords": [
      "free",
