      "scene": "KineticText",
      "props": {
        "lines": [
          "Hot take:",
          "launch leaderboards",
          "are a popularity",
          "contest."
        ],
        "mode": "slam",
        "highlight": [
          "popularity",
          "contest"
        ],
        "size": 110
      }
    },
    {
      "cue": "whoever",
      "scene": "KineticText",
      "props": {
        "lines": [
          "Most votes",
          "on day one",
          "wins."
        ],
        "mode": "slam",
        "highlight": [
          "wins"
        ],
        "size": 150
      }
    },
    {
      "cue": "that",
      "scene": "KineticText",
      "props": {
        "lines": [
          "Who has the",
          "biggest audience,",
          "not which app",
          "is good."
        ],
        "mode": "slam",
        "highlight": [
          "good"
        ],
        "size": 110
      }
    },
    {
      "cue": "so",
      "scene": "KineticText",
      "props": {
        "lines": [
          "So we built",
          "the opposite."
        ],
        "mode": "slam",
        "highlight": [
          "opposite"
        ],
        "size": 140
      }
    },
    {
      "cue": "tryworthy",
      "scene": "KineticText",
      "props": {
        "lines": [
